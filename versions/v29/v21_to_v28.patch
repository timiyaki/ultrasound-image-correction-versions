+def guard_group_highlights(frames: np.ndarray, p: ProcessParams, values: dict) -> dict:
+    """Protect bright internal detail under the actual shared group white point."""
+    result = dict(values)
+    q = replace(p, **result)
+    ids = np.linspace(0, len(frames)-1, min(16, len(frames)), dtype=int)
+    sample = frames[ids]
+    filtered = filter_chunk(sample, q, estimate_noise_variance(frames, q))
+    active = filtered[sample > q.black_level]
+    if not active.size:
+        return result
+    white = max(float(np.percentile(active, q.white_percentile)), 1.0)
+    bright = float(np.percentile(active, 99.5))/white
+    if bright > 0:
+        cap = ((250.0/255.0)**(1.0/q.gamma)-q.beta/255.0)/bright
+        result["alpha"] = round(min(q.alpha, max(0.5, cap)), 4)
+    return result
 
 
