+    mean = box_mean(z, p.lee_window//2)/np.maximum(support, 1e-8)
+    var = np.maximum(box_mean(z*z, p.lee_window//2)/np.maximum(support, 1e-8)-mean*mean, 0)
+    valid = (sample > 8) & (support > 0.98)
+    if not np.any(valid):
+        return 0.0
+    # A gradient on local means identifies coherent boundaries, not raw speckle.
+    gx = np.abs(np.diff(mean, axis=2, prepend=mean[:, :, :1]))
+    gy = np.abs(np.diff(mean, axis=1, prepend=mean[:, :1, :]))
+    gradient = gx+gy
+    flat = valid & (gradient <= np.percentile(gradient[valid], 65))
+    return float(np.percentile(var[flat if np.any(flat) else valid], p.noise_percentile))
