+    # Exclude empty support and strong transitions from the noise estimate.
+    sample_ids = np.linspace(0, len(frames)-1, min(12, len(frames)), dtype=int)
+    sample = np.maximum(frames[sample_ids].astype(np.float32)-p.black_level, 0.0)
+    z = np.log1p(sample)/math.log(256.0)
+    active = sample > 0
