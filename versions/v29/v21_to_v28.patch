+def bilateral_filter(frames: np.ndarray, active: np.ndarray,
+                     strength: float, sigma: float) -> np.ndarray:
+    """One 5x5 bilateral pass; sigma is in normalized log intensity."""
+    if strength <= 0:
+        return frames.copy()
+    radius = 2
+    padded = np.pad(frames, ((0,0),(radius,radius),(radius,radius)), mode="reflect")
+    support = np.pad(active, ((0,0),(radius,radius),(radius,radius)), mode="reflect")
+    total = np.zeros_like(frames)
+    mass = np.zeros_like(frames)
+    h,w = frames.shape[1:]
+    for dy in range(-radius,radius+1):
+        for dx in range(-radius,radius+1):
+            neighbor = padded[:,radius+dy:radius+dy+h,radius+dx:radius+dx+w]
+            valid = support[:,radius+dy:radius+dy+h,radius+dx:radius+dx+w]
+            weight = math.exp(-(dx*dx+dy*dy)/(2*1.2**2))
+            weight = weight*np.exp(-0.5*((neighbor-frames)/sigma)**2)*valid
+            total += weight*neighbor
+            mass += weight
+    result = frames + strength*(total/np.maximum(mass,1e-8)-frames)
+    result[~active] = 0.0
+    return result
 
 
